{
  "name": "smartfit",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "contracts:generate": "python backend/scripts/export_openapi.py && pnpm --filter @smartfit/contracts generate",
    "typecheck": "pnpm --filter @smartfit/contracts typecheck && pnpm --filter @smartfit/api-client typecheck && pnpm --filter @smartfit/web typecheck && pnpm typecheck:mobile",
    "dev:web": "pnpm --filter @smartfit/web dev",
    "build:web": "pnpm --filter @smartfit/web build",
    "dev:mobile": "pnpm --filter @smartfit/mobile start",
    "typecheck:mobile": "pnpm --filter @smartfit/mobile typecheck"
  }
}
