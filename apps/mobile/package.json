{
  "name": "@smartfit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "export": "expo export --platform all",
    "android:prebuild": "expo prebuild --platform android",
    "android:studio": "expo prebuild --platform android && open -a \"Android Studio\" ./android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@smartfit/api-client": "workspace:*",
    "@smartfit/contracts": "workspace:*",
    "expo": "~58.0.26",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1",
    "expo-camera": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-audio": "~58.0.12",
    "expo-location": "~58.0.22",
    "expo-keep-awake": "~58.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-task-manager": "~58.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.1.3",
    "jest-expo": "~58.0.12",
    "typescript": "~5.9.3"
  }
}
