{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@smartfit/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@smartfit/contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts",
    "../../packages/api-client/src/**/*.ts",
    "../../packages/contracts/src/**/*.ts"
  ]
}
