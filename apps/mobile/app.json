{
  "expo": {
    "name": "SmartFit",
    "slug": "smartfit-mobile",
    "scheme": "smartfit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permite a SmartFit proteger tu sesión."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SmartFit necesita acceder a la cámara para escanear códigos de barras y fotografiar comidas.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SmartFit necesita acceder a tus fotos para estimar comidas.",
          "cameraPermission": "SmartFit necesita acceder a la cámara para fotografiar comidas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SmartFit necesita acceso al micrófono para transcribir notas de voz de comida.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmartFit necesita acceder a tu ubicación mientras registras una ruta de andar o correr.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartfit.mobile"
    },
    "android": {
      "package": "com.smartfit.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#101914"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ce22b8cd-7db1-43e8-8d65-ce32bb98e67c"
      }
    },
    "owner": "guille279"
  }
}
