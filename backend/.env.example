DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health
TIMEZONE=Europe/Madrid

# Secreto compartido frontend <-> backend (cabecera X-API-Key). Vacío = sin comprobar.
API_TOKEN=change-me

# Proveedor de IA: "openrouter" o "openai" (API directa).
AI_PROVIDER=openrouter

# --- OpenRouter ---
# Crea una clave en https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-...
# El chat es gratuito; los embeddings pueden tener coste aparte.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=90

# --- OpenAI directo (alternativa) ---
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-... (solo desarrollo; en producción se lee de Vault)

# --- Vault (opcional, para OpenAI directo) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT=secret
VAULT_PATH=healthapp/openai
VAULT_KEY=api_key

# Open Food Facts exige un User-Agent identificable
OFF_USER_AGENT=HealthApp/0.1 (tu-email@ejemplo.com)
