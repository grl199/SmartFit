DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health
TIMEZONE=Europe/Madrid

# Secreto compartido frontend <-> backend (cabecera X-API-Key). Vacío = sin comprobar.
API_TOKEN=change-me

# Proveedor de IA: "huggingface" (recomendado para empezar sin coste OpenAI) o "openai".
AI_PROVIDER=huggingface

# --- Hugging Face Inference Providers ---
# Crea un token en https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...
# Modelo de chat con visión y soporte de herramientas (según proveedor disponible).
HUGGINGFACE_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Embeddings multilingües; el vector se adapta a la dimensión pgvector existente.
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TIMEOUT=90

# --- OpenAI (se conserva como alternativa) ---
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-... (solo desarrollo; en producción se lee de Vault)

# --- Vault (la API key de OpenAI se lee de aquí cuando AI_PROVIDER=openai) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT=secret
VAULT_PATH=healthapp/openai
VAULT_KEY=api_key

# Open Food Facts exige un User-Agent identificable
OFF_USER_AGENT=HealthApp/0.1 (tu-email@ejemplo.com)
