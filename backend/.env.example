DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health
TIMEZONE=Europe/Madrid

# --- Autenticación ---
# Clave para firmar las sesiones (JWT). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la dejas vacía se usa una aleatoria y las sesiones se pierden en cada reinicio.
SECRET_KEY=
TOKEN_TTL_HOURS=12
# false = nadie puede crear cuentas nuevas (útil cuando ya tienes la tuya y expones la app)
ALLOW_REGISTRATION=true
# Credenciales para el usuario 1 ya existente (anterior al login). Solo se aplican una vez, si ese usuario
# aún no tiene contraseña; después puedes borrar estas dos líneas.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=

# Proveedor de IA: "openrouter" o "openai" (API directa).
AI_PROVIDER=openrouter

# --- OpenRouter ---
# Crea una clave en https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-...
# El chat es gratuito; los embeddings pueden tener coste aparte.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=90

# --- OpenAI directo (alternativa) ---
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-... (solo desarrollo; en producción se lee de Vault)

# --- Vault (opcional, para OpenAI directo) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT=secret
VAULT_PATH=healthapp/openai
VAULT_KEY=api_key

# Open Food Facts exige un User-Agent identificable
OFF_USER_AGENT=HealthApp/0.1 (tu-email@ejemplo.com)
# Búsqueda de texto de Open Food Facts (OFF limita a 10 búsquedas/min/IP; aquí se deja un margen)
OFF_SEARCH_URL=https://search.openfoodfacts.org/search
OFF_SEARCH_PER_MINUTE=8
# Traduce al español (con IA, en segundo plano) los nombres de productos de Open Food Facts. false = solo limpieza
TRANSLATE_NAMES=true
